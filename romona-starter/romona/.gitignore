# ===========================================
# Romona .gitignore
# ===========================================

# Heavy data — re-downloaded by setup, don't push to git
data/ollama/
data/open-webui/
data/searxng/

# Personal data — back up separately, don't push to public repo
knowledge/about-me.md

# Backups
backups/

# Training artifacts (large binary files)
adapters/*.bin
adapters/*.safetensors
adapters/*.gguf
*.gguf

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp
*.swo
